# xchain-indexer configuration. Copy to .env and fill in values.
# Reads the decoder DB, processes ACTION logic, and writes to its own indexer
# DB. Optionally syncs config/price/DB state from xchain-hub.

# Required: coin (BTC / LTC / DOGE) and network (mainnet / testnet / regtest).
INDEXER_COIN=BTC
INDEXER_NETWORK=regtest

# Optional: JSON-RPC API port the indexer listens on.
INDEXER_API_PORT=3004

# Strongly recommended: API key protecting write + federation-read methods
# (callers send it as the "x-api-key" header). When left empty those methods
# are OPEN and a warning is logged at startup; set a key for any shared
# deployment.
# INDEXER_API_KEY=your-key-here

# Opt-in phase-2 fee dry-run RPC (feequotedryrun). It runs the REAL VM
# (DEPLOY/EXECUTE) against current state in a rolled-back txn and mutates
# AUTO_INCREMENT, so it is registered ONLY when this is set AND
# INDEXER_NETWORK=regtest, and is API-key-gated when a key is configured.
# Leave unset on any shared or mainnet node. Keep the regtest node isolated.
# INDEXER_ENABLE_DRYRUN=true

# Required: decoder MariaDB to read from.
DECODER_DB_HOST=127.0.0.1
DECODER_DB_PORT=3306
DECODER_DB_NAME=xchain_decoder
DECODER_DB_USER=xchain
DECODER_DB_PASS=your-db-password-here

# Required: indexer MariaDB to write to.
INDEXER_DB_HOST=127.0.0.1
INDEXER_DB_PORT=3306
INDEXER_DB_NAME=xchain_indexer
INDEXER_DB_USER=xchain
INDEXER_DB_PASS=your-db-password-here

# Optional: xchain-utxo-tracker location (used for balance lookups).
# UTXO_TRACKER_URL=127.0.0.1
# UTXO_TRACKER_API_PORT=3001

# --- Hub integration (optional) -----------------------------------------------
# Optional: hub REST endpoint + API key for price/config sync.
# HUB_API_URL=http://127.0.0.1:10000
# HUB_API_KEY=your-hub-api-key-here
# Optional: ms to wait for hub price sync before proceeding (default 60000).
# HUB_PRICE_SYNC_TIMEOUT_MS=60000

# Optional: replicate the hub DB locally. When enabled, supply the hub DB.
# HUB_DB_SYNC_ENABLED=false
# HUB_DB_SYNC_POLL_INTERVAL=30000
# HUB_DB_HOST=
# HUB_DB_PORT=
# HUB_DB_NAME=
# HUB_DB_USER=
# HUB_DB_PASS=

# Optional: ms the cross-chain-call pass waits, in direct-hub-DB mode (no HUB_DB_SYNC
# mirror), for an in-flight hub cross_chain_calls write to land before reading the table
# for a block (default 10000). Guards against injecting an XCALL execution/callback a
# block late versus a replaying node, which would shift the action-index counter and
# fork the ledger. Proceeds on timeout, so a quiet hub never stalls the tip; the hub-side
# XCALL_RELAY_MARGIN_BLOCKS is the primary guarantee and makes this a near-instant no-op.
# XCALL_DIRECT_PRESENCE_TIMEOUT_MS=10000

# Optional: tuning.
# CORS_ORIGIN=http://localhost
# DB_QUERY_TIMEOUT=30000
# Optional: connection-pool connect/acquire timeouts in ms (default 10000 each).
# DB_CONNECT_TIMEOUT=10000
# DB_ACQUIRE_TIMEOUT=10000
# Optional: ms between block-parse polls of the decoder DB (default 5000).
# BLOCK_CHECK_INTERVAL=5000
# Optional: watchdog timeout for processing a single block, in ms (default 300000).
# BLOCK_PROCESS_TIMEOUT=300000
# Optional: max rows returned by the validator-set queries (getActiveValidators /
# getValidatorsByCapability). Bounds the result on a large federation; a warning is
# logged if the cap is hit. Default 1000.
# VALIDATOR_QUERY_LIMIT=1000
