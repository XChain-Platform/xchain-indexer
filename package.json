{
  "name": "xchain-indexer",
  "description": "xchain-indexer is a free open source token platform indexer for the XChain platform",
  "version": "1.8.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/XChain-platform/xchain-indexer.git"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-json-rpc-router": "^1.4.0",
    "fs": "^0.0.1-security",
    "helmet": "^7.1.0",
    "mariadb": "^3.2.3",
    "mathjs": "^13.2.0"
  },
  "scripts": {
    "api": "node ./src/api.js",
    "test": "mocha --timeout 5000 --recursive 'test/unit/**/*.test.js' 'test/unit/*.test.js'",
    "test:integration": "mocha --timeout 30000 --recursive 'test/integration/scenarios/**/*.test.js'",
    "test:e2e": "mocha --no-config --timeout 60000 --exit 'test/e2e/scenarios/**/*.test.js'",
    "test:boundary": "mocha --no-config --timeout 5000 --recursive 'test/unit/boundary/**/*.test.js'",
    "test:smoke": "mocha --no-config --timeout 5000 'test/smoke/**/*.test.js'",
    "test:smoke:unit": "mocha --no-config --timeout 5000 'test/smoke/unit/**/*.test.js'",
    "test:smoke:connected": "mocha --no-config --timeout 5000 'test/smoke/connected/**/*.test.js'",
    "test:security": "mocha --no-config --timeout 5000 --recursive 'test/unit/security/**/*.test.js'",
    "test:perf": "mocha --no-config --timeout 0 --exit 'test/perf/scenarios/**/*.test.js'",
    "test:perf:baseline": "mocha --no-config --timeout 300000 --exit 'test/perf/scenarios/01-baseline-throughput.test.js'",
    "test:perf:benchmarks": "mocha --no-config --timeout 600000 --exit 'test/perf/scenarios/02-action-benchmarks.test.js'",
    "test:perf:sustained": "mocha --no-config --timeout 0 --exit 'test/perf/scenarios/03-sustained-load.test.js'",
    "test:perf:spike": "mocha --no-config --timeout 300000 --exit 'test/perf/scenarios/04-spike-load.test.js'",
    "test:perf:scaling": "mocha --no-config --timeout 600000 --exit 'test/perf/scenarios/05-scaling.test.js'",
    "test:fuzz": "mocha --no-config --timeout 0 --exit 'test/fuzz/suites/*.fuzz.js'",
    "test:fuzz:quick": "FUZZ_RUNS=1000 mocha --no-config --timeout 60000 --exit --grep @tier1 'test/fuzz/suites/*.fuzz.js'",
    "test:fuzz:full": "FUZZ_RUNS=10000 mocha --no-config --timeout 0 --exit 'test/fuzz/suites/*.fuzz.js'"
  },
  "devDependencies": {
    "fast-check": "^4.6.0",
    "mocha": "^11.7.5",
    "sinon": "^21.0.3"
  }
}
