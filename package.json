{
  "name": "xchain-indexer",
  "description": "xchain-indexer is a free open source token platform indexer for the XChain platform",
  "version": "0.11.0",
  "xchainRequiresHub": "0.11.0",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/XChain-Platform/xchain-indexer.git"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-json-rpc-router": "^1.4.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "mariadb": "3.5.2",
    "mathjs": "15.2.0",
    "ws": "^8.21.0",
    "xchain-vm": "file:./xchain-vm"
  },
  "scripts": {
    "api": "node --no-node-snapshot ./src/api.js",
    "migrate": "node ./src/migrate.js",
    "vendor:vm": "bash bin/vendor-vm.sh",
    "check:vm": "bash bin/vendor-vm.sh check",
    "check:consensus-time": "if grep -rn 'getCurrentTime(' src/actions/ 2>/dev/null; then echo 'ERROR: getCurrentTime() (wall-clock Date.now) must never be called inside src/actions/. Block processing must use the deterministic block timestamp (data[\"BLOCK_TIME\"]); a wall-clock value here diverges consensus state across validator instances'; exit 1; else echo 'OK: no wall-clock time usage in src/actions/'; fi",
    "test": "mocha --timeout 30000 --recursive 'test/unit/**/*.test.js' 'test/unit/*.test.js' 'test/regression/**/*.test.js' 'test/security/**/*.test.js'",
    "coverage": "c8 --reporter=text --reporter=html --include 'src/**/*.js' mocha --timeout 30000 --recursive 'test/unit/**/*.test.js' 'test/unit/*.test.js' 'test/regression/**/*.test.js' --exit",
    "coverage:check": "c8 --check-coverage --lines 87 --statements 87 --branches 83.6 --functions 81.4 --reporter=text-summary --include 'src/**/*.js' mocha --timeout 30000 --recursive 'test/unit/**/*.test.js' 'test/unit/*.test.js' 'test/regression/**/*.test.js' --exit",
    "ci": "npm run check:vm && mocha --timeout 30000 --recursive --exit 'test/unit/**/*.test.js' 'test/unit/*.test.js' 'test/regression/**/*.test.js' 'test/security/**/*.test.js'",
    "test:integration": "mocha --timeout 30000 --recursive 'test/integration/**/*.test.js'",
    "test:integration:ci": "mocha --no-config --timeout 120000 --exit 'test/integration/**/*.test.js'",
    "test:e2e": "mocha --no-config --timeout 60000 --exit 'test/e2e/scenarios/**/*.test.js'",
    "test:boundary": "mocha --no-config --timeout 5000 --recursive 'test/boundary/**/*.test.js' 'test/unit/boundary/**/*.test.js'",
    "test:smoke": "mocha --no-config --timeout 5000 'test/smoke/**/*.test.js'",
    "test:smoke:unit": "mocha --no-config --timeout 5000 'test/smoke/unit/**/*.test.js'",
    "test:smoke:connected": "mocha --no-config --timeout 5000 'test/smoke/connected/**/*.test.js'",
    "test:security": "mocha --no-config --timeout 5000 --recursive 'test/security/**/*.test.js' 'test/unit/security/**/*.test.js'",
    "test:perf": "mocha --no-config --timeout 0 --exit 'test/perf/scenarios/**/*.test.js'",
    "test:perf:baseline": "mocha --no-config --timeout 0 --exit 'test/perf/scenarios/01-baseline-throughput.test.js'",
    "test:perf:benchmarks": "mocha --no-config --timeout 600000 --exit 'test/perf/scenarios/02-action-benchmarks.test.js'",
    "test:perf:sustained": "mocha --no-config --timeout 0 --exit 'test/perf/scenarios/03-sustained-load.test.js'",
    "test:perf:spike": "mocha --no-config --timeout 300000 --exit 'test/perf/scenarios/04-spike-load.test.js'",
    "test:perf:scaling": "mocha --no-config --timeout 600000 --exit 'test/perf/scenarios/05-scaling.test.js'",
    "test:perf:grown": "mocha --no-config --timeout 0 --exit 'test/perf/scenarios/07-grown-database.test.js'",
    "test:perf:fastchain": "mocha --no-config --timeout 0 --exit 'test/perf/scenarios/08-fast-chain.test.js'",
    "test:perf:feespike": "mocha --no-config --timeout 0 --exit 'test/perf/scenarios/09-fee-spike.test.js'",
    "test:perf:regimes": "mocha --no-config --timeout 0 --exit 'test/perf/scenarios/08-fast-chain.test.js' 'test/perf/scenarios/09-fee-spike.test.js'",
    "test:fuzz": "mocha --no-config --timeout 0 --exit 'test/fuzz/suites/*.fuzz.js'",
    "test:fuzz:quick": "FUZZ_RUNS=1000 mocha --no-config --timeout 60000 --exit --grep @tier1 'test/fuzz/suites/*.fuzz.js'",
    "test:fuzz:full": "FUZZ_RUNS=10000 mocha --no-config --timeout 0 --exit 'test/fuzz/suites/*.fuzz.js'",
    "test:chaos": "mocha --no-config --timeout 10000 --recursive 'test/chaos/suites/*.test.js'",
    "test:mutation": "mocha --no-config --timeout 10000 --recursive 'test/mutation/suites/*.test.js'",
    "test:mutation:tier1": "mocha --no-config --timeout 10000 --grep @tier1 'test/mutation/suites/*.test.js'",
    "test:mutation:report": "MUTATION_REPORT=1 mocha --no-config --timeout 10000 --recursive 'test/mutation/suites/*.test.js'",
    "test:regression": "mocha --no-config --timeout 30000 --exit --grep @regression --recursive 'test/**/*.test.js'",
    "test:regression:fast": "mocha --no-config --timeout 5000 --exit --grep '@regression.*(tier1|tier4)' --recursive 'test/unit/**/*.test.js' 'test/regression/**/*.test.js'",
    "test:regression:full": "mocha --no-config --timeout 60000 --exit --grep @regression --recursive 'test/**/*.test.js'",
    "test:nodb": "npm run check:consensus-time && npm test && npm run test:chaos && npm run test:mutation && npm run test:fuzz:quick",
    "test:full": "npm run check:consensus-time && npm test && npm run test:integration && npm run test:e2e && npm run test:smoke && npm run test:chaos && npm run test:mutation && npm run test:fuzz:quick",
    "ci:full": "bash bin/ci-full.sh"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "fast-check": "^4.6.0",
    "mocha": "^11.7.5",
    "sinon": "^21.0.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "tmp": "^0.2.7",
    "mathjs": "15.2.0",
    "decimal.js": "10.4.3",
    "qs": "^6.15.2",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.5",
    "js-yaml": "^4.3.1"
  },
  "engines": {
    "comment": "Bounded to Node 22: the vendored xchain-vm dependency pulls isolated-vm 5.0.4, whose native binding fails node-gyp on Node 24 (removed V8 API). Node 22 also matches the node:22-bookworm image the indexer ships in. See .nvmrc.",
    "node": ">=22.0.0 <23"
  }
}
